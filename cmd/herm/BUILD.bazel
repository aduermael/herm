load("@rules_go//go:def.bzl", "go_binary", "go_library")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "herm_lib",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    embedsrcs = [
        "container_version",
        "dockerfiles/base.Dockerfile",
    ],
    importpath = "herm/cmd/herm",
    visibility = ["//visibility:private"],
    deps = [
        "//prompts",
        "@com_github_google_uuid//:go_default_library",
        "@com_github_rivo_uniseg//:go_default_library",
        "@com_langdag_langdag//:go_default_library",
        "@com_langdag_langdag//types:go_default_library",
        "@in_gopkg_yaml_v3//:go_default_library",
        "@org_golang_x_term//:go_default_library",
    ] + select({
        "@rules_go//go/platform:android": [
            "@com_github_ebitengine_purego//:go_default_library",
        ],
        "@rules_go//go/platform:darwin": [
            "@com_github_ebitengine_purego//:go_default_library",
        ],
        "@rules_go//go/platform:ios": [
            "@com_github_ebitengine_purego//:go_default_library",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_ebitengine_purego//:go_default_library",
        ],
        "//conditions:default": [],
    }),
)

go_binary(
    name = "herm",
    embed = [":herm_lib"],
)
